# Baked into the extension at build time (`npm run build`). Rebuild after changing.
# These are safe to ship to the browser: the publishable key is Supabase's public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Where the panel sends API requests. Local: http://localhost:3000
# Codespaces: https://<codespace-name>-3000.app.github.dev  (port 3000 must be Public)
VITE_API_BASE_URL=http://localhost:3000

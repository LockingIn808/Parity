# --- Required ---------------------------------------------------------------
# Supabase project URL (Project Settings -> API)
SUPABASE_URL=
# Supabase SECRET / service-role key. Server-side only. Never put this in frontend/.env.
SUPABASE_SECRET_KEY=
# Figma personal access token (Figma -> Settings -> Security -> Personal access tokens,
# scope "File content: read"). Server-side only.
FIGMA_ACCESS_TOKEN=

# --- Optional ---------------------------------------------------------------
PORT=3000
# Extra allowed browser origins, comma-separated. chrome-extension:// and localhost
# origins are always allowed, so the extension usually needs nothing here.
CORS_ORIGINS=

# Optional: powers the Explain button and "Ask about this element" box.
# Without it everything else still works and the AI box says it is not set up.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

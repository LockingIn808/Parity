{
  "manifest_version": 3,
  "name": "Parity",
  "version": "1.0.0",
  "description": "Compare your web implementation against your Figma design.",
  "key": "",
  "permissions": [
    "identity",
    "storage"
  ],
  "icons": {
    "16": "icons/mark.png",
    "48": "icons/mark.png",
    "128": "icons/mark.png"
  },
  "action": {
    "default_title": "Parity",
    "default_icon": {
      "16": "icons/mark.png",
      "32": "icons/mark.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "devtools_page": "devtools/devtools.html"
}
